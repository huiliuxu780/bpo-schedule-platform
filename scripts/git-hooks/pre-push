#!/usr/bin/env bash
# pre-push gate: run the full local verification before main reaches the remote.
# Enable once per clone with:
#   ln -sf ../../scripts/git-hooks/pre-push .git/hooks/pre-push
set -euo pipefail

push_to_main=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # Branch deletions carry an all-zero local sha; nothing to verify.
  if [[ "$local_sha" =~ ^0+$ ]]; then
    continue
  fi
  if [[ "$remote_ref" == "refs/heads/main" || "$local_ref" == "refs/heads/main" ]]; then
    push_to_main=1
  fi
done

if [[ "$push_to_main" -ne 1 ]]; then
  exit 0
fi

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

echo "pre-push: refs/heads/main is being pushed, running bash scripts/check.sh"
bash scripts/check.sh
